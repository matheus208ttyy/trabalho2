body {
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #f0f0f0;
}
#game-container {
    width: 400px;
    border: 2px solid #333;
    background: #fff;
    padding: 20px;
    border-radius: 10px;
}
.pokemon-box {
    margin-bottom: 15px;
}
.hp-bar {
    width: 100%;
    background: #ccc;
    height: 20px;
    border-radius: 5px;
    overflow: hidden;
}
.hp-bar div {
    height: 100%;
    background: #4caf50;
    width: 100%;
    transition: width 0.3s;
}
#battle-log {
    margin-top: 15px;
    font-weight: bold;
}
