<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Batalha Pokémon</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div id="game-container">
        <div id="enemy" class="pokemon-box">
            <h2>Charizard</h2>
            <div class="hp-bar"><div id="enemy-hp" style="width: 100%;"></div></div>
        </div>

        <div id="player" class="pokemon-box">
            <h2>Blastoise</h2>
            <div class="hp-bar"><div id="player-hp" style="width: 100%;"></div></div>
        </div>

        <div id="controls">
            <button onclick="playerAttack()">Ataque Rápido</button>
        </div>

        <div id="battle-log">A batalha começou!</div>
    </div>
    <script src="script.js"></script>
</body>
</html>
